# Settings for myai. install.sh writes the real file (/opt/myai/.env, mode 600)
# with fresh secrets; this file documents every key.
#
# By hand: copy this file to .env, fill in the empty values, then run
# `docker compose config` to check it. Format rules: KEY=value, no spaces
# around "=", comments on their own lines. Put single quotes around a value
# that contains "$", "#" or spaces. Generate a secret with: openssl rand -hex 32
#
# After editing, apply with `myai restart` (or `docker compose up -d`).

# ---------------------------------------------------------------- address ---

# Public host name of this server, without "https://". The certificate is
# issued for this name, so it must point to this machine.
SITE_ADDRESS=srv123456.hstgr.cloud

# Empty: Caddy gets a certificate from Let's Encrypt automatically. There is no
# second certificate authority then: ZeroSSL, Caddy's usual fallback, needs an
# account e-mail address. Names ending in sslip.io share one weekly Let's
# Encrypt limit with all other sslip.io users, which can run out. To let Caddy
# try ZeroSSL when Let's Encrypt fails, give a real address of yours:
#   CADDY_TLS_LINE='tls you@your-own-domain'
# (Let's Encrypt refuses placeholder addresses such as owner@example.com.)
# "tls internal": self-signed certificate (for localhost, a bare IP address or
# testing; browsers show a warning).
CADDY_TLS_LINE=

# Access code for the gate in front of everything. Letters and digits only
# (32 hex characters: openssl rand -hex 16). Opening
# https://<SITE_ADDRESS>/enter/<GATE_TOKEN> once lets a browser in for a year.
# Changing it locks out every browser until it opens the new link.
GATE_TOKEN=

# Time zone for schedules and for code the agent runs, e.g. Europe/Berlin.
TZ=UTC

# Where all state is kept (models, chats, agent database, certificates).
DATA_DIR=/opt/myai/data

# ----------------------------------------------------------------- images ---

# install.sh replaces LLAMA_IMAGE with the exact build it pulled and tested
# (image@sha256:...), so restarts stay on that build.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.13.5
SEARXNG_IMAGE=docker.io/searxng/searxng:2026.11.23-a7163d091
CADDY_IMAGE=caddy:2.11.9-alpine

# ------------------------------------------------------------------ model ---

# Catalogue id from config/models.conf. Informational; `myai model use <id>`
# changes it together with MODEL_FILE.
MODEL_ID=hauhau

# File name of the model inside DATA_DIR/models.
MODEL_FILE=Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf

# Name under which the model server offers the model. Leave as it is.
MODEL_ALIAS=assistant

# Context window in tokens, shared by all parallel slots (32768 / 2 = 16384 each).
LLM_CTX=32768

# Requests the model can work on at the same time.
LLM_PARALLEL=2

# CPU threads for generating text (installer: about 75% of the vCPUs) and for
# reading the prompt (installer: all vCPUs). `myai bench` finds good values.
LLM_THREADS=6
LLM_THREADS_BATCH=8

# RAM in MiB for cached prompts. Keep it low on a 32 GB server.
LLM_CACHE_RAM_MIB=2048

# Upper limit of "thinking" tokens per answer when thinking is on.
LLM_THINK_BUDGET=2048

# How the model file is loaded. mmap+mlock keeps it in RAM (never swapped out).
LLM_LOAD_MODE=mmap+mlock

# Sampling defaults recommended for the default model.
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_TOP_K=20
LLM_MIN_P=0
LLM_PRESENCE_PENALTY=1.0

# ---------------------------------------------------------------- secrets ---
# Each of the next five: openssl rand -hex 32. They are used only between the
# containers; you never type them.

# agent -> model server
LLM_API_KEY=

# Open WebUI -> agent (the OpenAI-compatible gateway); also accepted by the
# agent's API under /agent/api
AGENT_API_KEY=

# agent -> sandbox
SANDBOX_TOKEN=

# SearXNG's internal secret
SEARXNG_SECRET=

# Signs Open WebUI logins. Changing it logs everyone out.
WEBUI_SECRET_KEY=

# First Open WebUI administrator. Used only while Open WebUI has no user yet;
# afterwards change the password in Open WebUI itself.
WEBUI_ADMIN_EMAIL=owner@example.com
WEBUI_ADMIN_PASSWORD=
WEBUI_ADMIN_NAME=Owner

# Password for the agent dashboard at https://<SITE_ADDRESS>/agent/
# (the installer uses the same value as WEBUI_ADMIN_PASSWORD).
# Empty switches the dashboard's password login off.
DASHBOARD_PASSWORD=

# ------------------------------------------------------------------ agent ---

# Model "thinking" for agent work: off | on | auto
# (auto: off for chat, on for background and scheduled tasks).
AGENT_THINKING=auto

# Most model calls the agent may make for one task.
AGENT_MAX_STEPS=12

# Conversation history kept per request, in tokens.
# Must stay below LLM_CTX / LLM_PARALLEL.
AGENT_CTX_TOKENS=14000

# Longest answer per model call, in tokens.
AGENT_MAX_OUTPUT_TOKENS=1500

# on | off. On Hostinger the CPU is burstable: about 60% of all vCPUs is the
# sustained baseline, and using more for hours gets the whole server throttled.
# "on" makes background tasks pause before that happens (chat is never
# delayed). Use "off" on a server with dedicated CPUs.
CPU_GOVERNOR=on

# Share of the CPUs that may be used continuously (0.60 = 60%).
CPU_BASELINE=0.60

# After each background model call, rest this many times its duration.
BACKGROUND_REST_RATIO=0.5

# A schedule may not run more often than this many minutes.
MIN_SCHEDULE_INTERVAL_MIN=15

# Most schedules that can exist at once.
MAX_SCHEDULES=50

# true | false. false removes the agent's run_code tool (the sandbox).
ENABLE_RUN_CODE=true

# Optional Telegram bot. Token from @BotFather; empty = Telegram off.
# Set it with `myai telegram set <token>`.
TELEGRAM_BOT_TOKEN=

# Optional: numeric Telegram user IDs allowed to use the bot, comma-separated.
# Usually left empty; the first owner pairs with the code below.
TELEGRAM_ALLOWED_IDS=

# 8 digits. Send "/pair <code>" to the bot once to become its owner.
PAIRING_CODE=
